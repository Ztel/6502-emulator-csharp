<Window x:Class="Emulator6502.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Emulator6502"
        mc:Ignorable="d"
        ResizeMode="CanResize"
        Title="Debug" Height="590" Width="560" MinHeight="390" MinWidth="560">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="90"/>
                <RowDefinition Height="130"/>
            </Grid.RowDefinitions>

            <!-- Disassembly -->
            <GroupBox Header="Disassembly" Grid.Column="1" Grid.Row="0" Margin="0,0,5,0">
                <ListBox x:Name="lbDisassembly" Grid.Column="0" Margin="0,0,10,0" FontFamily="Consolas" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Key, StringFormat=X4}" Width="60" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Value.Item1}" Width="80" Margin="0,0,5,0" Foreground="Gray"/>
                                <TextBlock Text="{Binding Value.Item2}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <!-- CPU Registers -->
            <GroupBox Header="CPU Registers" Grid.Column="0" Grid.Row="1" Margin="0,0,5,0">
                <UniformGrid Columns="2" Margin="10,5,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Program Counter:" VerticalAlignment="Center" Height="25" HorizontalAlignment="Left"/>
                        <TextBox Width="50" HorizontalAlignment="Left" Margin="9,5,0,8" x:Name="tbProgramCounter"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="X Register:" VerticalAlignment="Center" Height="25" HorizontalAlignment="Center"/>
                        <TextBox Width="50" HorizontalAlignment="Left" Margin="10,5,0,8" x:Name="tbXRegister"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Accumulator:" VerticalAlignment="Center" Height="25" HorizontalAlignment="Left"/>
                        <TextBox Width="50" HorizontalAlignment="Left" Margin="33,5,0,8" x:Name="tbAccumulator"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Y Register:" VerticalAlignment="Center" Height="25" HorizontalAlignment="Center"/>
                        <TextBox Width="50" HorizontalAlignment="Left" Margin="10,5,0,8" x:Name="tbYRegister"/>
                    </StackPanel>
                </UniformGrid>
            </GroupBox>

            <!-- Flags Section -->
            <GroupBox Header="Flags" Margin="0,0,5,0" Grid.Row="2">
                <StackPanel Margin="10">

                    <!-- Status Register -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Status Register:" VerticalAlignment="Center"/>
                        <TextBox Height="20" Width="50" Margin="5,0,0,0" x:Name="tbStatusRegister"/>
                    </StackPanel>

                    <UniformGrid Columns="4">
                        <CheckBox Content="Carry" x:Name="cbCarry" Margin="5"/>
                        <CheckBox Content="Zero" x:Name="cbZero" Margin="5"/>
                        <CheckBox Content="Interrupt" x:Name="cbInterrupt" Margin="5"/>
                        <CheckBox Content="Decimal" x:Name="cbDecimal" Margin="5"/>
                        <CheckBox Content="Break" x:Name="cbBreak" Margin="5"/>
                        <CheckBox Content="[Reserved]" IsEnabled="False" Foreground="Gray" Margin="5"/>
                        <CheckBox Content="Overflow" x:Name="cbOverflow" Margin="5"/>
                        <CheckBox Content="Negative" x:Name="cbNegative" Margin="5"/>
                    </UniformGrid>
                </StackPanel>
            </GroupBox>

        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>

            <!-- Stack Section -->
            <GroupBox Header="Stack" Grid.Column="1"  Grid.Row="0">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Stack Pointer:" VerticalAlignment="Center"/>
                        <TextBox Width="50" Margin="5,0,0,0" x:Name="tbStackPointer"/>
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="lbStack" FontFamily="Consolas" IsEnabled="True" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Address, StringFormat=X4}" Width="40" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Value, StringFormat=X2}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </GroupBox>

            <!-- Controls Section -->
            <GroupBox Header="Controls" Grid.Column="1" Grid.Row="1">
                <StackPanel>
                    <Button Content="Reset" x:Name="btnReset" Click="BtnReset_Click" Margin="15,10,15,5" Background="#FFF0F0F0"/>
                    <Button Content="Pause" x:Name="btnPause" Click="BtnPause_Click" Margin="15,5,15,5" Background="#FFF0F0F0"/>
                    <Button Content="Step Frame" x:Name="btnStepFrame" Click="BtnStepFrame_Click" Margin="15,5,15,5" Background="#FFF0F0F0"/>
                    <Button Content="Step Instruction" x:Name="btnStepInstruction"  Click="BtnStepInstruction_Click" Margin="15,5,15,5" Background="#FFF0F0F0"/>
                </StackPanel>
                
            </GroupBox>

        </Grid>
    </Grid>
</Window>
