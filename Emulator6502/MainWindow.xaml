<Window x:Class="Emulator6502.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Emulator6502"
        mc:Ignorable="d"
        Title="Emulator6502" Height="380" Width="330" ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height= "20"/>
            <RowDefinition/>
            <RowDefinition Height= "20"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Background="#FFFFFFFF">
            <MenuItem Header="_File">
                <MenuItem Header="_Load ROM" x:Name="btnLoadRom" Click="BtnLoadRom_Click"/>
                <MenuItem Header="_Eject ROM" x:Name="btnEjectRom" Click="BtnEjectRom_Click"/>
                <MenuItem Header="_Quit" x:Name="btnQuit" Click="BtnQuit_Click"/>
            </MenuItem>
            <MenuItem Header="_Emulation">
                <MenuItem Header="Create _Savestate" x:Name="btnCreateSavestate">
                    <MenuItem Header="Slot _0" x:Name="btnSaveSlot0" Click="BtnSaveSlot_Click"/>
                    <MenuItem Header="Slot _1" x:Name="btnSaveSlot1" Click="BtnSaveSlot_Click"/>
                    <MenuItem Header="Slot _2" x:Name="btnSaveSlot2" Click="BtnSaveSlot_Click"/>
                    <MenuItem Header="Slot _3" x:Name="btnSaveSlot3" Click="BtnSaveSlot_Click"/>
                </MenuItem>
                <MenuItem Header="_Load Savestate" x:Name="btnLoadSavestate">
                    <MenuItem Header="Slot _0" x:Name="btnLoadSlot0" Click="BtnLoadSlot_Click"/>
                    <MenuItem Header="Slot _1" x:Name="btnLoadSlot1" Click="BtnLoadSlot_Click"/>
                    <MenuItem Header="Slot _2" x:Name="btnLoadSlot2" Click="BtnLoadSlot_Click"/>
                    <MenuItem Header="Slot _3" x:Name="btnLoadSlot3" Click="BtnLoadSlot_Click"/>
                </MenuItem>
                <MenuItem Header="_Reset" x:Name="btnReset" Click="BtnReset_Click"/>
                <MenuItem Header="_Pause" x:Name="btnPause" Click="BtnPause_Click"/>
                <MenuItem Header="Step _Frame" x:Name="btnStepFrame" Click="BtnStepFrame_Click"/>
                <MenuItem Header="Step _Instruction" x:Name="btnStepInstruction" Click="BtnStepInstruction_Click"/>
            </MenuItem>
            <MenuItem Header="_Debug">
                <MenuItem Header="Open _Debug Window" x:Name="btnOpenDebugWindow" Click="BtnOpenDebugWindow_Click"/>
                <MenuItem Header="Open _Memory Viewer" x:Name="btnOpenMemoryViewer" Click="BtnOpenMemoryViewer_Click"/>
            </MenuItem>
            <MenuItem Header="_Config">
                <MenuItem Header="Set ROM Path"/>
            </MenuItem>
        </Menu>

        <!-- ASCII Display -->
        <Rectangle Grid.Row="1" Fill="Black"/>

        <TextBlock Grid.Row="1" x:Name="tbDisplayGrid" Text="{Binding RenderedDisplay}"  HorizontalAlignment="Center" VerticalAlignment= "Center" 
                   FontFamily="Consolas" Height="300" Width="320" xml:space="preserve" Foreground="#FFD4D4D4" 
                   FontSize="18" TextAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="18.5"/>

        <!-- Footer -->
        <TextBlock Grid.Row="3" x:Name="tbRomStatus" HorizontalAlignment="Left" VerticalAlignment="Center" 
                   Height="15" Width="300" xml:space="preserve" Foreground="#FF000000" 
                   FontSize="12" TextAlignment="Left"> No ROM loaded.</TextBlock>
    </Grid>
</Window>
