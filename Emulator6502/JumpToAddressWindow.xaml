<Window x:Class="Emulator6502.JumpToAddressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Emulator6502"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Input Address..." Height="125" Width="220">
    <Grid>
        <StackPanel Margin="10,10,10,0">
            <TextBlock Text="Enter Address (Hex):" Margin="0,0,0,5"/>
            <TextBox x:Name="tbAddress" KeyDown="TbAddress_KeyDown" MaxLength="4" Margin="0,0,0,10"/>
            <Button Content="Find" Width="80" HorizontalAlignment="Center" Click="BtnFind_Click"/>
        </StackPanel>
    </Grid>
</Window>
